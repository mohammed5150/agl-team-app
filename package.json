{
  "name": "adb-agl-portal",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "verify-dist": "node scripts/verify-dist.js",
    "test": "vitest run",
    "ci": "vitest run && node build.js && node scripts/verify-dist.js",
    "dev": "esbuild app.jsx --bundle --outfile=app.js --loader:.jsx=jsx --watch --jsx-factory=React.createElement --jsx-fragment=React.Fragment --define:__SHOW_DEMO__=true",
    "start": "serve dist -l 8080"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "serve": "^14.2.6",
    "vitest": "^4.1.10"
  }
}
