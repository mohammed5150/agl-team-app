# Server-side Supabase configuration (@supabase/server).
#
# On Supabase Edge Functions every one of these is injected automatically by
# the platform: nothing to configure there. Copy this file to `.env` (which is
# gitignored) only when running server code in another runtime, e.g. the
# backup/restore scripts or a local harness.
#
# The URL and publishable key are public: the same values ship in the client
# bundle (src/supabasePortal.js). The secret key is NOT public. Get it from
# the dashboard (Project Settings -> API Keys) and never commit it.

SUPABASE_URL=https://vzipsbecmirbkrbrpcdt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_c6qyKoJaPEyTQ3-8nv7oFg_i3waClyQ
SUPABASE_SECRET_KEY=sb_secret_...          # from API Keys settings; keep out of git
SUPABASE_JWKS_URL=https://vzipsbecmirbkrbrpcdt.supabase.co/auth/v1/.well-known/jwks.json
